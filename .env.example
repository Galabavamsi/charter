# Copy to .env. Never commit .env.
# Test and live Razorpay keys cannot be set in the same environment.

CHARTER_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000
WEBHOOK_PORT=3001
MCP_PORT=3002
# Behind one load balancer (AWS Lightsail, Render) set 1; add 1 more for an orange-cloud Cloudflare proxy.
# 0 trusts no forwarded headers; 1 trusts the single proxy directly in front.
# TRUST_PROXY_HOPS=0

# Development default. Production APIs must connect as the restricted charter_app role.
DATABASE_URL=postgres://charter:charter@127.0.0.1:5432/charter
TEST_DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379

# Supabase Auth. Publishable keys are browser-safe; never put secret or service keys here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Vite exposes only these browser-safe values to the frontend.
# concierge-web loads them from this repo-root file (vite envDir), and Docker
# must also provide them at frontend build time — not only at API runtime.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_JWKS_URL=

# Razorpay Test only for v1. Key ID must start with rzp_test_
# No quotes, no spaces around =. Example: RAZORPAY_KEY_ID=rzp_test_abc123
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Fireworks (function-calling model). No quotes.
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4p1-flash

# Langfuse Japan
LANGFUSE_HOST=https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Public HTTPS origin of this deployment. Production must use the public
# https origin, not localhost. Used for CORS, voice, and same-origin links.
# Example: https://charter.humanslop.in
CHARTER_PUBLIC_URL=
# Optional frontend origin for auth confirmation redirects when window is unavailable.
# Leave unset in the browser so sign-up uses the current origin (deployed origin vs localhost).
# VITE_PUBLIC_URL=
# Required in staging/production. Generate a unique random value of at least 32 characters.
CHARTER_CURSOR_SECRET=

# Voice — Vapi only for v1. No quotes.
# VAPI_API_KEY = Private key (Server-side API access)
# VAPI_PUBLIC_KEY = Public key (browser widget, later)
VAPI_API_KEY=
VAPI_PUBLIC_KEY=

# Mail
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=

# Optional later
# BOLNA_API_KEY=
# DEEPGRAM_API_KEY=

# Demo spending caps: model-backed chat/voice turns per user per UTC day, and for the whole site.
CHARTER_DAILY_TURNS_PER_USER=40
CHARTER_DAILY_TURNS_GLOBAL=400
